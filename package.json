{
  "name": "discord-bot-admin",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted Discord bot with admin UI and PostgreSQL storage",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "rm -rf dist .next && prisma generate && node ./node_modules/next/dist/bin/next build --webpack && tsc -p tsconfig.server.json",
    "check": "npm run build",
    "start": "node dist/main.js",
    "start:pm2": "pm2 start ecosystem.config.cjs --env production",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "admin:bootstrap": "tsx src/scripts/bootstrap-admin.ts"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@heroui/react": "^2.8.7",
    "@heroui/theme": "^2.4.25",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "discord.js": "^14.21.0",
    "dotenv": "^16.4.7",
    "framer-motion": "^12.29.2",
    "next": "16.1.4",
    "prisma": "^6.5.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
