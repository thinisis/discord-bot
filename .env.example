NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_MODE=all
# Prisma runtime URL. For Neon this is usually the pooled connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Prisma migration URL. For Neon use the direct/non-pooled connection string.
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Use at least 32 random characters in production.
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_SESSION_TTL_HOURS=168
# Optional one-time bootstrap admin on app startup.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
DISCORD_TOKEN=your-discord-bot-token
DISCORD_APPLICATION_ID=your-application-id
# Optional: use one guild for immediate slash-command refresh while developing
DISCORD_COMMAND_GUILD_ID=
BOT_PRESENCE_TEXT=Monitoring your server
LAVALINK_URL=http://127.0.0.1:2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_CLIENT_NAME=discord-bot-admin/1.0.0
LAVALINK_RESUME_TIMEOUT_SECONDS=60
MUSIC_PLAYLIST_MAX_ITEMS=100
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: only used by the PM2 ecosystem example
LAVALINK_JAR=/opt/lavalink/Lavalink.jar
LAVALINK_CONFIG=/www/wwwroot/discord-bot/infra/lavalink/application.yml
JAVA_BIN=java
